# Public settings only. scripts/init_deployment.py creates .env without overwriting it.
BRIDGE_MODE=selfhost
BRIDGE_DOMAIN=relay.example.test
BRIDGE_ADMIN_LOGIN=admin
# The initializer writes admin/admin setup-only credentials.
# The first login must set a new password; no initialization code is required.
# The server website is administrator-only; hosted users register via clients.
BRIDGE_EDGE_SUBNET=172.30.74.0/28
BRIDGE_PROXY_IP=172.30.74.2
BRIDGE_MAX_CONNECTIONS=1024
BRIDGE_BYTES_PER_SECOND=1048576

# Only for the explicit deploy/compose.hosted.yaml overlay:
# SMTP_ADDRESS=smtp.example.test:587
# SMTP_HOST=smtp.example.test
# SMTP_FROM=bridge@example.test
# SMTP_USER=bridge@example.test
